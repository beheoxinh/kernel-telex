<?xml version="1.0" encoding="utf-8"?>
<component>
  <name>org.freedesktop.IBus.ktelex</name>
  <description>KTelex Component</description>
  <exec>/usr/libexec/ibus-engine-ktelex --ibus</exec>
  <version>1.0.2</version>
  <author>Luong Thanh Lam &lt;ltlam93@gmail.com&gt;</author>
  <license>GPL</license>
  <homepage>https://github.com/BambooEngine/ibus-bamboo</homepage>
  <textdomain>ibus-ktelex</textdomain>
  <engines>
    <engine>
      <name>KTelex</name>
      <longname>KTelex</longname>
      <description>Vietnamese Input Method</description>
      <language>vi</language>
