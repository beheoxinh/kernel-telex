      <symbol>EN</symbol>
      <rank>0</rank>
    </engine>
    <engine>
      <name>KtelexGb</name>
      <longname>KTelex</longname>
      <description>English Input Method (UK)</description>
      <language>en_GB</language>
      <license>GPL</license>
      <author>Luong Thanh Lam &lt;ltlam93@gmail.com&gt;</author>
      <icon>/usr/share/ktelex/icons/us.svg</icon>
      <layout>gb</layout>
      <symbol>EN</symbol>
