#!/usr/bin/env bash
# Run the test suite with the race detector.
set -euo pipefail
cd "$(dirname "$0")/.."
if [ "$(uname)" = FreeBSD ]; then
	export CGO_CFLAGS="-I/usr/local/include -std=gnu99"
	export CGO_LDFLAGS="-L/usr/local/lib -lX11 -lXtst -pthread"
fi
CGO_ENABLED=1 go test -mod=vendor -race -count=1 ./...
