#!/usr/bin/env bash
# Copy the built files into PREFIX (default /usr). Usage: scripts/install [PREFIX] [DESTDIR]
# Needs root for system prefixes; never builds (run scripts/build first).
set -euo pipefail
cd "$(dirname "$0")/.."

engine_name="ktelex"
PREFIX="${1:-/usr}"
DESTDIR="${2:-}"
DIST="${DIST:-dist}"

if [ ! -x "${DIST}/ibus-engine-${engine_name}" ]; then
	echo "Thiếu ${DIST}/ibus-engine-${engine_name}: hãy chạy 'make build' trước." >&2
	exit 1
fi

# The engine reads its data from DataDir (utils.go: /usr/share/ktelex).
engine_dir="${DESTDIR}${PREFIX}/share/${engine_name}"
libexec_dir="${DESTDIR}${PREFIX}/libexec"
component_dir="${DESTDIR}${PREFIX}/share/ibus/component"
apps_dir="${DESTDIR}${PREFIX}/share/applications"

install -d "${engine_dir}" "${libexec_dir}" "${component_dir}" "${apps_dir}"
rm -rf "${engine_dir}/data" "${engine_dir}/icons"
cp -R icons data "${engine_dir}/"
install -m 0755 "${DIST}/ibus-engine-${engine_name}" "${libexec_dir}/"
[ -x "${DIST}/ktelex-uinput" ] && install -m 0755 "${DIST}/ktelex-uinput" "${libexec_dir}/"
install -m 0644 "data/${engine_name}.xml" "${component_dir}/"
install -m 0644 "data/ibus-setup-KTelex.desktop" "${apps_dir}/"
