# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test
xtest

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
# Build output (scripts/build writes to dist/)
/dist/
/ktelex
/ktelex-uinput
/ibus-engine-ktelex
/uinput-server

.vim/
.git/
.idea/
.ccls-cache/
test-data/

# Dependency directories
# vendor/ is committed: it carries a trimmed bamboo-core (Telex only).

# Local packaging leftovers / tool state
/build/
.codegraph/
.serena/

# Never hide sources, whatever a global excludes file says
!/*.go
!/*.sh
!/cmd/**
!/vendor/**
